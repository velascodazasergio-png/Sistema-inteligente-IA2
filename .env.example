# Copia este archivo como .env y completa los valores. .env NO se sube al repositorio.

# ---------- Base de datos (Docker Compose) ----------
POSTGRES_DB=incidents_db
POSTGRES_USER=incidents
POSTGRES_PASSWORD=cambia-esta-clave

# ---------- Integración backend ↔ n8n ----------
# Encabezado que el backend envía al webhook de n8n. Debe coincidir con la
# credencial "Header Auth" configurada en el nodo Webhook del flujo 02.
N8N_WEBHOOK_AUTH_HEADER=X-N8N-Token
N8N_WEBHOOK_AUTH_VALUE=genera-un-token-largo-y-aleatorio

# Token que n8n envía en X-Callback-Token al devolver respuestas o fallos.
# Vacío = el backend no lo exige (solo para desarrollo).
CALLBACK_TOKEN=genera-otro-token-largo-y-aleatorio

# Orígenes del frontend permitidos por CORS (admite comodines de puerto)
CORS_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*

# ---------- n8n: RAG con OpenRouter y Qdrant ----------
# La clave de OpenRouter se guarda como credencial "Header Auth" dentro de n8n
# (Authorization: Bearer <clave>), no en este archivo.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_MODEL=nombre-del-modelo-de-embeddings
EMBEDDING_DIM=1536
LLM_MODEL=nombre-del-modelo-de-chat
QDRANT_COLLECTION=knowledge_articles
RAG_SCORE_THRESHOLD=0.75
RAG_TOP_K=5
MIN_CHARS_DESCRIPCION=20

TZ=America/Bogota
