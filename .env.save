# Copia este archivo como .env y completa los valores. .env NO se sube al repositorio.

# ---------- Base de datos (Docker Compose) ----------
POSTGRES_DB=incidents_db
POSTGRES_USER=incidents
POSTGRES_PASSWORD=5501c956ed13c1dfbd5e8cc0c8e05a488d7a85be8780e414

# ---------- Integración backend ↔ n8n ----------
# Encabezado que el backend envía a los webhooks de n8n. Obligatorio: n8n crea
# su credencial "Header Auth" con estos mismos valores al arrancar.
N8N_WEBHOOK_AUTH_HEADER=X-N8N-Token
N8N_WEBHOOK_AUTH_VALUE=123f9c2b5b92b4b7359f497810659a499b3c4ab019329f4b

# Token que n8n envía en X-Callback-Token al devolver respuestas o fallos.
# Vacío = el backend no lo exige (solo para desarrollo).
CALLBACK_TOKEN=e6a3c603fd1ca38982abf421cdf959b2ff197aad53c01122

# También identifica a n8n cuando lee artículos de la API (rol de servicio, sin usuario).

# Clave para firmar las sesiones (JWT HS256): mínimo 32 caracteres aleatorios.
# Vacía = clave aleatoria en cada arranque (las sesiones se cierran al reiniciar el backend).
JWT_SECRET=cbfec8ab55f9195546a37b705ebf70bf0ee134171f68c426
# Duración de la sesión en minutos (480 = 8 horas)
JWT_EXPIRATION_MINUTES=480
# Contraseña inicial de los usuarios de data.sql (admin, técnicos y empleados).
# Solo se asigna a usuarios que aún no tienen contraseña. Cámbiala fuera de una demostración.
DEMO_PASSWORD=Soporte2026*

# Orígenes del frontend permitidos por CORS (admite comodines de puerto)
CORS_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*

# ---------- n8n: RAG con OpenRouter y Qdrant ----------
# Clave de OpenRouter (https://openrouter.ai/keys). Solo la clave, sin "Bearer".
# Después de cambiarla: docker compose up -d n8n
OPENROUTER_API_KEY=Bearersk-or-v1-54c78ddab9ad3195bc6958834f4fcda53eb9ad42a8b528796e9bfb0f155b0d79
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIM=1536
LLM_MODEL=openai/gpt-4o-mini
QDRANT_COLLECTION=knowledge_articles
# Medido con openai/text-embedding-3-small: incidentes con artículo 0,675–0,809;
# sin relación 0,220–0,367 (ver docs/pruebas, sección 3d). 0,55 separa ambos grupos.
RAG_SCORE_THRESHOLD=0.55
RAG_TOP_K=5
MIN_CHARS_DESCRIPCION=20

# true: al arrancar, n8n crea sus credenciales e importa y activa el flujo combinado (n8n/setup.sh).
# false: no toca n8n (para editar flujos en la interfaz sin que se sobrescriban).
N8N_AUTO_SETUP=true

TZ=America/Bogota

# ---------- Puertos del host (solo si los predeterminados ya están ocupados) ----------
# El backend debe seguir en 8080 o cambiar también la URL en Configuración del frontend.
POSTGRES_PORT=5432
BACKEND_PORT=8080
FRONTEND_PORT=5500
# Página por HTTPS (certificado autofirmado en ./certs, o uno real)
FRONTEND_HTTPS_PORT=5443
QDRANT_PORT=6333
N8N_PORT=5678
