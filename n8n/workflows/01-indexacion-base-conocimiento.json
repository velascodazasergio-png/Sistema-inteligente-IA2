    {
      "parameters": {
        "jsCode": "const t0 = Date.now();\nconst raw = $input.first().json;\nconst b = raw.body ?? raw;\nconst id = b.articleId == null ? null : Number(b.articleId);\nif (id !== null && (!Number.isInteger(id) || id <= 0)) throw new Error('articleId inválido');\nif (id === null && b.all !== true) throw new Error('Indique articleId o all=true');\nreturn [{ json: { t0, articleId: id, all: id === null } }];"
      },
      "id": "74644d81-fbcc-4e54-964f-9a24276cb13a",
      "name": "Validar solicitud",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        330,
        300
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.SPRING_BASE_URL }}/api/v1/knowledge-articles{{ $json.articleId ? '/' + $json.articleId : '' }}",
        "options": {
          "timeout": 20000
        }
      },
      "id": "6106d725-7d1f-45a0-8a74-c19c21c0e044",
      "name": "Obtener artículos (Spring Boot)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        300
      ],
      "onError": "continueRegularOutput",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const req = $('Validar solicitud').first().json;\nconst hash = s => { let h = 5381; for (let i = 0; i < s.length; i++) h = ((h << 5) + h + s.charCodeAt(i)) | 0; return (h >>> 0).toString(16); };\nconst articulos = $input.all().map(i => i.json).filter(a => a && !a.error && a.id != null);\nconst indexar = [], eliminar = [], omitidos = [];\nfor (const a of articulos) {\n  if (a.active !== true) { eliminar.push(a.id); omitidos.push({ id: a.id, motivo: 'desactivado' }); continue; }\n  if (a.verified !== true) { eliminar.push(a.id); omitidos.push({ id: a.id, motivo: 'sin verificar' }); continue; }\n  if (typeof a.title !== 'string' || !a.title.trim() || typeof a.content !== 'string' || !a.content.trim()) { omitidos.push({ id: a.id, motivo: 'título o contenido vacío' }); continue; }\n  const texto = `Categoría: ${a.categoryName ?? 'N/D'}\\nTítulo: ${a.title.trim()}\\nContenido: ${a.content.trim()}`;\n  indexar.push({ id: a.id, texto, payload: {\n    knowledgeArticleId: a.id, title: a.title, categoryId: a.categoryId ?? null, categoryName: a.categoryName ?? null,\n    referenceUrl: a.referenceUrl ?? null, authorUserId: a.authorUserId ?? null,\n    active: true, verified: true, articleUpdatedAt: a.updatedAt ?? null,\n    contentHash: hash(texto), embeddingModel: $env.EMBEDDING_MODEL, indexedAt: new Date().toISOString(), source: 'spring-boot'\n  } });\n}\nif (!req.all && !articulos.some(a => a.id === req.articleId)) {\n  eliminar.push(req.articleId);\n  omitidos.push({ id: req.articleId, motivo: 'no existe en Spring Boot; se elimina su vector' });\n}\nreturn [{ json: { t0: req.t0, indexar, eliminar: [...new Set(eliminar)], omitidos, hayIndexar: indexar.length > 0, hayEliminar: eliminar.length > 0 } }];"
      },
      "id": "40f08fd0-ba17-4063-a70a-13eef492b201",
      "name": "Clasificar artículos",
