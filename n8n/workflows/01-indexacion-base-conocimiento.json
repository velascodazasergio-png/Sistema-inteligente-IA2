        "jsCode": "const req = $('Validar solicitud').first().json;\nconst e = $json.error;\nconst msg = typeof e === 'string' ? e : (e?.message ?? JSON.stringify(e ?? ''));\nreturn [{ json: { status: 'ERROR',\n  errorCode: /CONFIG:/.test(msg) ? 'CONFIGURACION_INVALIDA' : (/timeout|timed out|ETIMEDOUT/i.test(msg) ? 'TIMEOUT' : 'INDEXACION_FALLO'),\n  message: 'La indexación no se completó. El estado de los vectores no está garantizado; reintente.',\n  technicalDetail: msg.slice(0, 200), processingTimeMs: Date.now() - req.t0 } }];"
      },
