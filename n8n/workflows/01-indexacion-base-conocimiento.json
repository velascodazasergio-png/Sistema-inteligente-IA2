    {
      "parameters": {
        "jsCode": "const c = $('Clasificar artículos').first().json;\nreturn [{ json: { status: 'OK', indexed: c.indexar.map(x => x.id), deleted: c.eliminar, skipped: c.omitidos,\n  embeddingModel: $env.EMBEDDING_MODEL, processingTimeMs: Date.now() - c.t0 } }];"
      },
