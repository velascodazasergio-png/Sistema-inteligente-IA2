        "url": "={{ $env.OPENROUTER_BASE_URL }}/embeddings",
        "options": {
          "timeout": 60000
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: $env.EMBEDDING_MODEL, input: $json.indexar.map(x => x.texto) }) }}"
      },
      "id": "828559a5-fe0b-4460-b83d-c544246e3459",
      "name": "Generar embeddings (lote)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1530,
        300
      ],
      "onError": "continueErrorOutput",
      "credentials": {
        "httpHeaderAuth": {
          "id": "REEMPLAZAR",
          "name": "OpenRouter API Key"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const c = $('Clasificar artículos').first().json;\nconst data = [...($json.data ?? [])].sort((a, b) => a.index - b.index);\nif (data.length !== c.indexar.length) throw new Error('Cantidad de embeddings distinta a la de artículos');\nconst dim = Number($env.EMBEDDING_DIM);\nconst points = c.indexar.map((x, i) => {\n  const v = data[i].embedding;\n  if (!Array.isArray(v) || (dim && v.length !== dim)) throw new Error(`CONFIG: dimensión inesperada en el artículo ${x.id}`);\n  return { id: x.id, vector: v, payload: x.payload };\n});\nreturn [{ json: { points } }];"
      },
